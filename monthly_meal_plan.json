# Generate unique 30-day plan
start_date = date(2025, 5, 1)
days = []

for i in range(30):
    current_date = start_date + timedelta(days=i)
    lunch = all_lunches[i % len(all_lunches)]
    snack = snacks[i % len(snacks)]
    dinner = dinners[i % len(dinners)]

    day_plan = {
        "date": current_date.isoformat(),
        "meals": [
            {
                "name": "Lunch",
                "title": lunch["title"],
                "time": "12:00",
                "calories": lunch["calories"],
                "ingredients": lunch["ingredients"],
                "instructions": lunch["instructions"]
            },
            {
                "name": "Mellanmål",
                "title": snack["title"],
                "time": "15:00",
                "calories": snack["calories"],
                "ingredients": snack["ingredients"],
                "instructions": snack["instructions"]
            },
            {
                "name": "Middag",
                "title": dinner["title"],
                "time": "17:30",
                "calories": dinner["calories"],
                "ingredients": dinner["ingredients"],
                "instructions": dinner["instructions"]
            }
        ]
    }
    days.append(day_plan)

# Save updated JSON
json_path = "/mnt/data/cleaned_unique_meal_plan.json"
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(days, f, ensure_ascii=False, indent=2)

json_path
