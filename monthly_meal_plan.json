# Shuffle and spread lunches over 30 days, avoiding close repetition
spread_lunches = (unique_lunches * 3)[:30]
shuffle(spread_lunches)

# Use previously defined snacks and dinners
days = []
start_date = date(2025, 5, 1)

for i in range(30):
    lunch = spread_lunches[i]
    snack = snacks[i % len(snacks)]
    dinner = dinners[i % len(dinners)]

    day_plan = {
        "date": (start_date + timedelta(days=i)).isoformat(),
        "meals": [
            {
                "name": "Lunch",
                "title": lunch["title"],
                "time": "12:00",
                "calories": lunch["calories"],
                "ingredients": lunch["ingredients"],
                "instructions": lunch["instructions"]
            },
            {
                "name": "Mellanmål",
                "title": snack["title"],
                "time": "15:00",
                "calories": snack["calories"],
                "ingredients": snack["ingredients"],
                "instructions": snack["instructions"]
            },
            {
                "name": "Middag",
                "title": dinner["title"],
                "time": "17:30",
                "calories": dinner["calories"],
                "ingredients": dinner["ingredients"],
                "instructions": dinner["instructions"]
            }
        ]
    }
    days.append(day_plan)

# Save to JSON
json_path = "/mnt/data/meal_plan_30days_varied.json"
